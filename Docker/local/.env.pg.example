APP_NAME=Komiut
APP_ENV=local
APP_KEY=base64:SWaJGN45f8CSPTYm54fXGsIlFqQ3+3mfF5F5qDwgzb0=
APP_DEBUG=true
APP_URL=http://localhost:8001

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default connection = local Postgres (never the production VPC host).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=komiut
DB_USERNAME=komiut
DB_PASSWORD=secret
DB_CHARSET=utf8

# Brand: komiut (resolved by hostname localhost or the X-App-Key header).
KOMIUT_DB_DRIVER=pgsql
KOMIUT_HOST=localhost
KOMIUT_HOST_ALT=127.0.0.1
KOMIUT_APP_KEY=komiut-local-key
KOMIUT_DB_HOST=db
KOMIUT_DB_PORT=5432
KOMIUT_DB_DATABASE=komiut
KOMIUT_DB_USERNAME=komiut
KOMIUT_DB_PASSWORD=secret
KOMIUT_DB_CHARSET=utf8
KOMIUT_SESSION_COOKIE=komiut_session

# Brand: safiri (same local DB for the smoke test).
SAFIRI_DB_DRIVER=pgsql
SAFIRI_HOST=safiri.localhost
SAFIRI_APP_KEY=safiri-local-key
SAFIRI_DB_HOST=db
SAFIRI_DB_PORT=5432
SAFIRI_DB_DATABASE=komiut
SAFIRI_DB_USERNAME=komiut
SAFIRI_DB_PASSWORD=secret
SAFIRI_DB_CHARSET=utf8
SAFIRI_SESSION_COOKIE=safiri_session

# Redis (dockerized) for cache + sessions.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_DRIVER=reverb
CACHE_STORE=redis
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MAIL_MAILER=log

# Reverb websocket server (live vehicle tracking). Connect the app to ws://localhost:8080
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=komiut-local
REVERB_APP_KEY=komiut-local-key
REVERB_APP_SECRET=komiut-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
