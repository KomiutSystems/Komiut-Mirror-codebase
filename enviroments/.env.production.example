# Production env TEMPLATE. Do NOT commit real values — on the EC2 host this file
# is rendered from AWS SSM Parameter Store (SecureString) at deploy time. Rotate
# the previously-leaked credentials HERE, never back into git.

APP_NAME=Komiut
APP_ENV=production
APP_KEY=            # php artisan key:generate --show  (store in SSM, rotate)
APP_DEBUG=false
APP_URL=https://komiut.co.ke

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# One shared database (RDS Postgres). Passengers are global; brand is a column.
DB_CONNECTION=pgsql
DB_HOST=            # RDS endpoint, e.g. komiut-db.xxxx.eu-west-1.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=komiut
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8

# Brand resolution (single DB — these are branding/feature only, NOT DB creds).
KOMIUT_HOST=komiut.co.ke
KOMIUT_HOST_ALT=www.komiut.co.ke
KOMIUT_APP_KEY=            # the key the komiut mobile build sends in X-App-Key
KOMIUT_SESSION_COOKIE=komiut_session
KOMIUT_SESSION_DOMAIN=.komiut.co.ke

SAFIRI_HOST=2safiri.co.ke
SAFIRI_HOST_ALT=www.2safiri.co.ke
SAFIRI_APP_KEY=
SAFIRI_SESSION_COOKIE=safiri_session
SAFIRI_SESSION_DOMAIN=.2safiri.co.ke

# ElastiCache Redis (cache + sessions + queue). Keys are brand-prefixed in code.
REDIS_CLIENT=phpredis
REDIS_HOST=            # ElastiCache primary endpoint
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120

# Uploads on S3 (offload the EBS volume).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=          # prefer the EC2 instance role over static keys
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=

MAIL_MAILER=ses
