APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# White-label brands (config/brands.php). One database per brand.
# Hostnames resolve the brand for web requests; app keys for the mobile apps
# via the X-App-Key header. Leave an app key blank to disable mobile access.
KOMIUT_HOST=portal.komiut.co.ke
KOMIUT_HOST_ALT=
KOMIUT_APP_KEY=
KOMIUT_SESSION_COOKIE=komiut_session
KOMIUT_SESSION_DOMAIN=
KOMIUT_FEATURE_PARCELS=true
KOMIUT_FEATURE_CARPOOL=false
KOMIUT_FEATURE_WALLET=true
KOMIUT_FEATURE_BOOKINGS=true
KOMIUT_FEATURE_LOYALTY=false
KOMIUT_DB_HOST=127.0.0.1
KOMIUT_DB_PORT=3306
KOMIUT_DB_DATABASE=komiut
KOMIUT_DB_USERNAME=
KOMIUT_DB_PASSWORD=

SAFIRI_HOST=portal.2safiri.co.ke
SAFIRI_HOST_ALT=
SAFIRI_APP_KEY=
SAFIRI_SESSION_COOKIE=safiri_session
SAFIRI_SESSION_DOMAIN=
SAFIRI_FEATURE_PARCELS=false
SAFIRI_FEATURE_CARPOOL=true
SAFIRI_FEATURE_WALLET=true
SAFIRI_FEATURE_BOOKINGS=true
SAFIRI_FEATURE_LOYALTY=false
SAFIRI_DB_HOST=127.0.0.1
SAFIRI_DB_PORT=3306
SAFIRI_DB_DATABASE=safiri
SAFIRI_DB_USERNAME=
SAFIRI_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
