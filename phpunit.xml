<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Phase 0 characterization-test net: a fixed key so the framework boots without a .env -->
        <env name="APP_KEY" value="base64:9idnz+0SZ9x4/2qdbinSqvPcnO7djwrQD5kC1LoJWps="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Run the suite against PostgreSQL, because staging and production are
             PostgreSQL and sqlite cannot reproduce how it behaves.

             sqlite (like MySQL) is permissive where PostgreSQL is strict: it
             coerces text to numbers and ignores identifier case. Two endpoints
             shipped 500ing on PostgreSQL while the whole suite passed green on
             sqlite: SUM() over a varchar column, and a mixed-case identifier
             folded to lower case. A suite that cannot fail the way production
             fails is not testing production.

             Points at a DEDICATED database, never the dev one: RefreshDatabase
             truncates. Defaults match docker-compose.local.yml; PHPUnit does not
             override variables already present in the real environment, so CI can
             point these elsewhere without editing this file.

               docker compose -f docker-compose.local.yml up -d db
               docker exec <db> psql -U komiut -d komiut -c 'CREATE DATABASE komiut_test OWNER komiut;'
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="54321"/>
        <env name="DB_DATABASE" value="komiut_test"/>
        <env name="DB_USERNAME" value="komiut"/>
        <env name="DB_PASSWORD" value="secret"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Broadcasting must NOT fall back to the null driver here. NullBroadcaster's
             auth() is an empty method, so every /broadcasting/auth call would return
             200 and no channel callback in routes/channels.php would ever run - the
             exact blind spot that let BroadcastServiceProvider sit commented out for
             months. Reverb signs its auth response locally (HMAC, no network), so the
             real authorization path executes offline. -->
        <env name="BROADCAST_CONNECTION" value="reverb"/>
        <env name="REVERB_APP_ID" value="testing"/>
        <env name="REVERB_APP_KEY" value="testing-reverb-key"/>
        <env name="REVERB_APP_SECRET" value="testing-reverb-secret"/>
        <env name="REVERB_HOST" value="localhost"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
